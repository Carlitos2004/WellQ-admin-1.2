# ── CONFIGURACIÓN GENERAL DEL SERVIDOR ────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
DEBUG=True
ALLOWED_ORIGINS=http://localhost:5173

# ── BASE DE DATOS ─────────────────────────────────────────────────────────────
# LOCAL (Docker, ver docker-compose.yml): la línea de abajo + DB_SSL=false
DATABASE_URL=postgresql+asyncpg://wellq:wellq_local_pass@localhost:5432/wellq
DB_SSL=false
# NEON (producción): usa la URL postgresql+asyncpg://... de Neon y pon DB_SSL=true

# ── KEYCLOAK (opcional — el login real usa JWT local) ─────────────────────────
KEYCLOAK_URL=
KEYCLOAK_REALM=wellq
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_ROLE=wellq-admin

# ── GOOGLE CLOUD & FIRESTORE (opcional) ───────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
GCP_PROJECT_ID=

# ── FIRESTORE & MONGODB (opcional) ────────────────────────────────────────────
FIRESTORE_DATABASE=(default)
MONGODB_URI=
MONGODB_DB_NAME=wellq_analytics

# ── EMAIL TRANSACCIONAL (SMTP GMAIL) — opcional ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=WellQ Admin
SMTP_FROM_EMAIL=
